# --- core ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- database (Railway Postgres with pgvector; local default shown) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# --- redis / celery ---
REDIS_URL=redis://localhost:6379/0

# --- auth (fastapi-users, in this backend) ---
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_LIFETIME_SECONDS=604800
# Session is delivered as an httpOnly cookie. In production (HTTPS) set
# AUTH_COOKIE_SECURE=true and AUTH_COOKIE_DOMAIN to the shared parent domain
# (e.g. .example.com) so app.example.com and api.example.com share it.
AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_DOMAIN=.example.com
AUTH_COOKIE_SAMESITE=lax

# --- cors: comma-separated frontend origins ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Cloudflare R2 (S3-compatible object storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- LLM providers (swap provider by config, not code) ---
# LLM_PROVIDER: openai | anthropic | azure  (agent + grounding judge + reranker)
LLM_PROVIDER=openai
CHAT_MODEL=gpt-4.1
GROUNDING_MODEL=gpt-4.1-mini
AGENT_REQUEST_LIMIT=6

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=          # for LLM_PROVIDER=anthropic (Claude)
# AZURE_OPENAI_ENDPOINT=      # for LLM_PROVIDER=azure / EMBEDDING_PROVIDER=azure
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- embeddings (independent provider; Anthropic has none) ---
EMBEDDING_PROVIDER=openai       # openai | azure
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- reranking (optional quality step after retrieval) ---
RERANK_ENABLED=false
RERANK_CANDIDATES=20

# --- retrieval tuning ---
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_TOP_K=8
RETRIEVAL_RRF_K=60
RETRIEVAL_NEIGHBOR_RADIUS=1
RETRIEVAL_FTS_CONFIG=english

# --- ingestion ---
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_RATIO=0.15

# --- event engine (retries + recovery) ---
EVENT_MAX_ATTEMPTS=3
EVENT_RETRY_BASE_DELAY_SECONDS=10
EVENT_RETRY_MAX_DELAY_SECONDS=600
STALE_PROCESSING_MINUTES=30
STALE_SWEEP_INTERVAL_SECONDS=300

# --- webhooks (signed ingress) ---
# HMAC-SHA256 secret senders sign the raw body with; empty rejects all.
WEBHOOK_SIGNING_SECRET=
WEBHOOK_SIGNATURE_HEADER=X-Signature-256

# --- rate limiting (chat is the costly path) ---
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60

# --- email (Resend; leave key empty to disable — sends become no-ops) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
FRONTEND_URL=http://localhost:3000

# --- observability (optional; leave empty to disable) ---
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
